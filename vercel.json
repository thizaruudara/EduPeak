{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!css/|js/|assets/|screenshots/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.edupeak.lk"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/((?!css/|js/|assets/|screenshots/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "teacher.edupeak.lk"
        }
      ],
      "destination": "/teacher-portal.html"
    },
    {
      "source": "/((?!css/|js/|assets/|screenshots/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.(?<domain>.*)"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/((?!css/|js/|assets/|screenshots/|favicon\\.ico|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "teacher.(?<domain>.*)"
        }
      ],
      "destination": "/teacher-portal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
